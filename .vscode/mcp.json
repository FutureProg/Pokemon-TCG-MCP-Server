{
    "servers": {
        "pokemonTCGStdio": {
            "type": "stdio",
            "command": "deno",
            "args": [
                "run",
                "--allow-net",
                "--allow-read",
                "--allow-env",
                "--env-file",
                "main.ts"
            ],
            "env": {
                "MCP_SERVER_TRANSPORT": "stdio"
            }
        },
        "pokemonTCGHttp": {
            "url": "http://localhost:8000",
            "type": "http"
        }
    }
}